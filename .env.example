# ===== 数据库 =====
# 本地开发（docker compose 起的 postgres）
DATABASE_URL=postgresql+asyncpg://memoloop:memoloop_dev_pwd@localhost:5433/memoloop

# ===== 大模型（OpenAI 协议兼容，任选其一即可）=====
# 例：OpenAI https://api.openai.com/v1 ；DeepSeek https://api.deepseek.com/v1 ；通义 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# ===== Embedding =====
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=BAAI/bge-m3

# ===== 认证 =====
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_EXPIRE_DAYS=7

# ===== 其他 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
UPLOAD_MAX_MB=50
